{
  "name": "@ritualdev-lab/devshelf",
  "version": "1.1.2",
  "private": false,
  "type": "module",
  "description": "The open-source community directory for discovering 520+ developer tools, free APIs, AI agents, and open-source projects. Includes terminal CLI and MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RitualDev-Lab/DevShelf.git"
  },
  "homepage": "https://devshelf.ritualdev.in",
  "keywords": [
    "developer-tools",
    "free-apis",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "open-source",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "devshelf": "bin/cli.js",
    "devshelf-mcp": "bin/mcp.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": ["bin", "shelf", "site/data.json"],
  "scripts": {
    "devshelf": "node bin/cli.js",
    "mcp": "node bin/mcp.js",
    "build:css": "tailwindcss -i site/input.css -o site/tailwind.min.css --minify",
    "generate:counts": "tsx scripts/generate-counts.ts",
    "build": "pnpm run build:css && tsx scripts/build-site.ts && tsx scripts/build-readme.ts && tsx scripts/generate-seo.ts && tsx scripts/generate-counts.ts && tsx scripts/generate-badges.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "validate": "tsx scripts/validate-shelf.ts",
    "validate:pr": "tsx scripts/validate-pr.ts",
    "validate:links": "node scripts/validate-links.js",
    "ai:optimize": "tsx scripts/ai-optimize-pr.ts",
    "check:links": "tsx scripts/check-links.ts",
    "benchmark": "tsx scripts/benchmark-performance.ts",
    "sunset": "tsx scripts/sunset-resources.ts",
    "issues:rot": "tsx scripts/generate-rot-issues.ts",
    "audit:trial-bait": "tsx scripts/audit-trial-bait.ts",
    "wiki:sync": "node scripts/sync-wiki.cjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.20.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
